# Copier en ".env" (jamais committé) et compléter au fur et à mesure.

# "true" une fois le compte AdSense validé ET PUBLIC_ADSENSE_CLIENT_ID
# renseigné ci-dessous. Tant que ce n'est pas le cas (ou si absent),
# SlotPub reste en mode placeholder (encadré neutre, aucun script).
PUB_ACTIVE=false

# Identifiant client AdSense (ex. "ca-pub-XXXXXXXXXXXXXXXX"). PUBLIC_ car lu
# côté navigateur par le script de chargement conditionné au consentement.
PUBLIC_ADSENSE_CLIENT_ID=

# Identifiant de mesure GA4 (ex. "G-XXXXXXXXXX"). Tant qu'il est vide, le
# chargement de Google Analytics reste un no-op même si l'utilisateur
# consent.
PUBLIC_GA_MEASUREMENT_ID=
