---
import { useTranslations } from '../../i18n/utils';

interface Props {
  type?: 'info' | 'attention' | 'danger' | 'astuce';
}

const { type = 'info' } = Astro.props;
const t = useTranslations();

const styles = {
  info: 'var(--couleur-information)',
  attention: 'var(--couleur-attention)',
  danger: 'var(--couleur-danger)',
  astuce: 'var(--couleur-succes)'
} as const;

const couleur = styles[type];
const libelle = t.avertissement[type];
---

<div
  class="not-prose my-4 rounded-lg border-l-4 p-4 text-sm"
  style={`border-color: ${couleur}; background-color: var(--couleur-fond-secondaire);`}
>
  <p class="mb-1 font-mono font-semibold uppercase tracking-wide" style={`color: ${couleur};`}>{libelle}</p>
  <div>
    <slot />
  </div>
</div>
