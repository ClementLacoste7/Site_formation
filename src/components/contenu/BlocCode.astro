---
import { Code } from 'astro:components';
import { useTranslations } from '../../i18n/utils';

interface Props {
  code: string;
  langue?: string;
  numerosDeLigne?: boolean;
}

const { code, langue = 'text', numerosDeLigne = true } = Astro.props;
const t = useTranslations();
const id = `bloc-code-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class="not-prose relative my-4 overflow-hidden rounded-lg border"
  style="border-color: var(--couleur-bordure);"
  data-bloc-code={id}
>
  <button
    type="button"
    class="absolute right-2 top-2 rounded border px-2 py-1 text-xs"
    style="border-color: var(--couleur-bordure); background-color: var(--couleur-fond);"
    data-bouton-copier={id}
  >
    {t.code.copier}
  </button>
  <div class:list={['overflow-x-auto p-4 text-sm', { 'avec-numeros': numerosDeLigne }]}>
    <Code
      code={code}
      lang={langue}
      themes={{ light: 'github-light', dark: 'github-dark' }}
      defaultColor={false}
    />
  </div>
</div>

<script define:vars={{ id, texteCopie: t.code.copie, texteCopier: t.code.copier }}>
  const bouton = document.querySelector(`[data-bouton-copier="${id}"]`);
  const conteneur = document.querySelector(`[data-bloc-code="${id}"]`);
  bouton?.addEventListener('click', async () => {
    const texte = conteneur?.querySelector('code')?.textContent ?? '';
    await navigator.clipboard.writeText(texte);
    bouton.textContent = texteCopie;
    setTimeout(() => {
      bouton.textContent = texteCopier;
    }, 1500);
  });
</script>

<style>
  .avec-numeros :global(pre) {
    counter-reset: ligne;
  }
  .avec-numeros :global(.line) {
    counter-increment: ligne;
  }
  .avec-numeros :global(.line)::before {
    content: counter(ligne);
    display: inline-block;
    width: 2rem;
    margin-right: 1rem;
    text-align: right;
    color: var(--couleur-texte-attenue);
    user-select: none;
  }

  /* Double thème Shiki (voir <Code themes defaultColor={false}> ci-dessus) :
     la palette suit data-theme, pas prefers-color-scheme. Astro nomme la
     classe générée "astro-code", pas "shiki". */
  :global(.astro-code),
  :global(.astro-code span) {
    color: var(--shiki-light);
  }
  :global(.astro-code) {
    background-color: var(--shiki-light-bg) !important;
  }
  :global([data-theme='dark'] .astro-code),
  :global([data-theme='dark'] .astro-code span) {
    color: var(--shiki-dark);
  }
  :global([data-theme='dark'] .astro-code) {
    background-color: var(--shiki-dark-bg) !important;
  }
</style>
