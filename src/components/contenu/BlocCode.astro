---
import { Code } from 'astro:components';
import { useTranslations } from '../../i18n/utils';

interface Props {
  code: string;
  langue?: string;
  numerosDeLigne?: boolean;
}

const { code, langue = 'text', numerosDeLigne = true } = Astro.props;
const t = useTranslations();
const id = `bloc-code-${Math.random().toString(36).slice(2, 9)}`;
---

{/* Fenêtre terminal (voir CLAUDE.md, invariants Lot 7) : surface toujours
    sombre, bordure verte, en-tête à trois pastilles. Le thème Shiki reste
    donc figé sur "github-dark" quel que soit le thème de la page. */}
<div class="not-prose fenetre-terminal my-4" data-bloc-code={id}>
  <div class="fenetre-terminal__entete">
    <span class="fenetre-terminal__pastille"></span>
    <span class="fenetre-terminal__pastille"></span>
    <span class="fenetre-terminal__pastille"></span>
    <span class="fenetre-terminal__titre">{langue}</span>
    <button
      type="button"
      class="ml-auto rounded border px-2 py-1 font-mono text-xs"
      style="border-color: var(--couleur-accent); color: var(--couleur-terminal-texte);"
      data-bouton-copier={id}
    >
      {t.code.copier}
    </button>
  </div>
  <div class:list={['overflow-x-auto p-4 text-sm', { 'avec-numeros': numerosDeLigne }]}>
    <Code code={code} lang={langue} theme="github-dark" />
  </div>
</div>

<script define:vars={{ id, texteCopie: t.code.copie, texteCopier: t.code.copier }}>
  const bouton = document.querySelector(`[data-bouton-copier="${id}"]`);
  const conteneur = document.querySelector(`[data-bloc-code="${id}"]`);
  bouton?.addEventListener('click', async () => {
    const texte = conteneur?.querySelector('code')?.textContent ?? '';
    await navigator.clipboard.writeText(texte);
    bouton.textContent = texteCopie;
    setTimeout(() => {
      bouton.textContent = texteCopier;
    }, 1500);
  });
</script>

<style>
  .avec-numeros :global(pre) {
    counter-reset: ligne;
  }
  .avec-numeros :global(.line) {
    counter-increment: ligne;
  }
  .avec-numeros :global(.line)::before {
    content: counter(ligne);
    display: inline-block;
    width: 2rem;
    margin-right: 1rem;
    text-align: right;
    color: color-mix(in srgb, var(--couleur-terminal-texte) 55%, transparent);
    user-select: none;
  }

  /* La fenêtre terminal (voir .fenetre-terminal, global.css) porte déjà le
     fond sombre : on neutralise le fond que Shiki appose sur <pre> pour
     éviter un double-fond, sans toucher à sa palette syntaxique. */
  :global(.astro-code) {
    background-color: transparent !important;
  }
</style>
