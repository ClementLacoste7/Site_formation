---
import { useTranslations } from '../../i18n/utils';

interface Props {
  points: string[];
}

const { points } = Astro.props;
const t = useTranslations();
---

<aside
  class="my-6 rounded-lg border p-4"
  style="border-color: var(--couleur-bordure); background-color: var(--couleur-fond-secondaire);"
>
  <h2 class="font-semibold">{t.chapitre.aRetenir}</h2>
  <ul class="mt-2 list-inside list-disc space-y-1 text-sm">
    {points.map((point) => <li>{point}</li>)}
  </ul>
</aside>
