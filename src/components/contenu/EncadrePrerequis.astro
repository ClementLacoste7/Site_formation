---
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import { resoudreCours, resoudreDomaine, urlChapitre } from '../../lib/contenu';

interface Props {
  prerequis: string[];
}

const { prerequis } = Astro.props;
const t = useTranslations();

const liens: { titre: string; href: string }[] = [];

if (prerequis.length > 0) {
  const chapitres = await getCollection('chapitres');
  for (const slug of prerequis) {
    const chapitre = chapitres.find((c) => c.data.slug === slug);
    if (!chapitre) continue;
    const cours = await resoudreCours(chapitre);
    if (!cours) continue;
    const domaine = await resoudreDomaine(cours);
    if (!domaine) continue;
    liens.push({ titre: chapitre.data.titreCourt, href: urlChapitre(chapitre, cours, domaine) });
  }
}
---

{
  liens.length > 0 && (
    <aside
      class="rounded-lg border p-4"
      style="border-color: var(--couleur-bordure); background-color: var(--couleur-fond-secondaire);"
    >
      <h2 class="font-semibold">{t.chapitre.prerequis}</h2>
      <ul class="mt-2 list-inside list-disc space-y-1 text-sm">
        {liens.map((lien) => (
          <li>
            <a href={lien.href} class="underline">
              {lien.titre}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
