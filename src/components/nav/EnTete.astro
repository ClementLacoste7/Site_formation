---
import { useTranslations } from '../../i18n/utils';

const t = useTranslations();
---

<header class="border-b" style="border-color: var(--couleur-bordure);">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a href="/fr/" class="text-lg font-semibold">Cybercursus</a>
    <nav class="flex items-center gap-4 text-sm">
      <a href="/fr/cours/">{t.nav.cours}</a>
      <a href="/fr/fiches/">{t.nav.fiches}</a>
      <button
        id="bascule-theme"
        type="button"
        aria-label={t.theme.bascule}
        class="rounded border px-2 py-1"
        style="border-color: var(--couleur-bordure);"
      >
        🌓
      </button>
    </nav>
  </div>
</header>

<script>
  import { initBasculeTheme } from '../../scripts/theme';
  initBasculeTheme('#bascule-theme');
</script>
