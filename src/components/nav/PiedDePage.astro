---
import { useTranslations } from '../../i18n/utils';

const t = useTranslations();
const annee = new Date().getFullYear();

const liens = [
  { href: '/fr/plan-du-site/', label: 'Plan du site' },
  { href: '/fr/a-propos/', label: 'À propos' },
  { href: '/fr/contact/', label: 'Contact' },
  { href: '/fr/mentions-legales/', label: 'Mentions légales' },
  { href: '/fr/confidentialite/', label: 'Confidentialité' },
  { href: '/fr/cookies/', label: 'Cookies' }
];
---

<footer class="mt-auto border-t" style="border-color: var(--couleur-bordure);" data-pagefind-ignore>
  <div class="mx-auto max-w-5xl px-4 py-6 text-sm" style="color: var(--couleur-texte-attenue);">
    <nav class="flex flex-wrap gap-x-4 gap-y-2">
      {liens.map((lien) => (
        <a href={lien.href} class="hover:underline">{lien.label}</a>
      ))}
      <button type="button" data-gerer-consentement class="underline">
        {t.consentement.modifier}
      </button>
    </nav>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
      <p>&copy; {annee} Cybercursus — {t.footer.droits}</p>
      <button type="button" data-reinitialiser-progression class="underline">
        {t.progression.reinitialiser}
      </button>
    </div>
  </div>
</footer>

<script>
  import { reinitialiserProgression } from '../../scripts/progression';
  import { useTranslations } from '../../i18n/utils';

  const t = useTranslations();
  const bouton = document.querySelector<HTMLButtonElement>('[data-reinitialiser-progression]');
  bouton?.addEventListener('click', () => {
    if (confirm(t.progression.confirmation)) {
      reinitialiserProgression();
      location.reload();
    }
  });

  document.querySelector('[data-gerer-consentement]')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('rouvrir-consentement'));
  });
</script>
