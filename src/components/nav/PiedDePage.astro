---
import { useTranslations } from '../../i18n/utils';

const t = useTranslations();
const annee = new Date().getFullYear();
---

<footer class="mt-auto border-t" style="border-color: var(--couleur-bordure);">
  <div
    class="mx-auto max-w-5xl px-4 py-6 text-sm"
    style="color: var(--couleur-texte-attenue);"
  >
    <p>&copy; {annee} Cybercursus — {t.footer.droits}</p>
  </div>
</footer>
