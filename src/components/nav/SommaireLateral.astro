---
import { useTranslations } from '../../i18n/utils';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const t = useTranslations();
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length > 0 && (
    <nav class="sticky top-4 hidden self-start text-sm lg:block" aria-label={t.chapitre.sommaire}>
      <p class="mb-2 font-semibold" style="color: var(--couleur-texte-attenue);">
        {t.chapitre.sommaire}
      </p>
      <ol class="space-y-2 border-l" style="border-color: var(--couleur-bordure);">
        {items.map((item) => (
          <li>
            <a
              href={`#${item.slug}`}
              data-sommaire-lien={item.slug}
              class="-ml-px block border-l-2 border-transparent py-0.5 pl-3"
              style="color: var(--couleur-texte-attenue); border-color: transparent;"
            >
              {item.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script>
  const liens = document.querySelectorAll<HTMLAnchorElement>('[data-sommaire-lien]');

  if (liens.length > 0) {
    const observateur = new IntersectionObserver(
      (entrees) => {
        for (const entree of entrees) {
          if (!entree.isIntersecting) continue;
          const id = entree.target.id;
          liens.forEach((lien) => {
            lien.style.borderColor =
              lien.dataset.sommaireLien === id ? 'var(--couleur-accent)' : 'transparent';
          });
        }
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    document.querySelectorAll('h2[id]').forEach((h2) => observateur.observe(h2));
  }
</script>
