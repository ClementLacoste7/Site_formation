---
interface Props {
  titre: string;
  description?: string;
  /** Chemin absolu de l'image OG (ex. "/og/injections-sql/principe.png"). Défaut : image du site. */
  image?: string;
  type?: 'website' | 'article';
}

const { titre, description, image = '/og/defaut.png', type = 'website' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const imageAbsolue = new URL(image, Astro.site).toString();
const titreComplet = `${titre} · Cybercursus`;
---

<title>{titreComplet}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />

<!-- V1 monolingue (section 2.3/3.3 de SPEC.md) : hreflang générés dès
     maintenant en préparation de l'internationalisation, mais ne pointent
     que vers le français tant qu'aucune autre langue n'est publiée. -->
<link rel="alternate" hreflang="fr" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Cybercursus" />
<meta property="og:locale" content="fr_FR" />
<meta property="og:title" content={titreComplet} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageAbsolue} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
