---
import '../styles/global.css';
import EnTete from '../components/nav/EnTete.astro';
import PiedDePage from '../components/nav/PiedDePage.astro';
import ModaleRecherche from '../components/nav/ModaleRecherche.astro';
import BandeauConsentement from '../components/pub/BandeauConsentement.astro';
import MetaSeo from '../components/seo/MetaSeo.astro';

interface Props {
  titre: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { titre, description, image, type } = Astro.props;
const lang = Astro.currentLocale ?? 'fr';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Script bloquant : pose data-theme avant le premier rendu pour éviter le
         flash. Ordre de priorité (invariant 16 de CLAUDE.md) : choix explicite
         déjà stocké, sinon préférence système, sinon sombre par défaut.
         "Sombre par défaut" s'applique quand on ne sait rien du visiteur, pas
         contre un réglage système explicite. -->
    <script is:inline>
      (function () {
        const stocke = localStorage.getItem('theme');
        const preferenceConnue = typeof window.matchMedia === 'function';
        const theme =
          stocke ||
          (preferenceConnue && window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <MetaSeo titre={titre} description={description} image={image} type={type} />
    <meta name="generator" content={Astro.generator} />
    <slot name="tete" />
    <!-- Consent Mode v2 : pose les signaux par défaut sur "denied" avant
         tout autre script Google. Aucune requête réseau, aucun cookie. -->
    <script>
      import { initialiserConsentModeDefaut } from '../scripts/consentement';
      initialiserConsentModeDefaut();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <EnTete />
    <main class="flex-1">
      <slot />
    </main>
    <PiedDePage />
    <ModaleRecherche />
    <BandeauConsentement />
  </body>
</html>
