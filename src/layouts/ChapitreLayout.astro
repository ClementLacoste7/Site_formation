---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FilAriane from '../components/nav/FilAriane.astro';
import NavChapitre from '../components/nav/NavChapitre.astro';
import SommaireLateral from '../components/nav/SommaireLateral.astro';
import PourAllerPlusLoin from '../components/nav/PourAllerPlusLoin.astro';
import EncadreObjectifs from '../components/contenu/EncadreObjectifs.astro';
import EncadrePrerequis from '../components/contenu/EncadrePrerequis.astro';
import Quiz from '../components/interactif/Quiz.astro';
import SlotPub from '../components/pub/SlotPub.astro';
import Commentaires from '../components/nav/Commentaires.astro';
import DonneesStructurees from '../components/seo/DonneesStructurees.astro';
import { useTranslations } from '../i18n/utils';
import { urlCours, urlDomaine, urlChapitre } from '../lib/contenu';
import { cleChapitre } from '../scripts/progression';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface ChapitreVoisin {
  chapitre: CollectionEntry<'chapitres'>;
  cours: CollectionEntry<'cours'>;
  domaine: CollectionEntry<'domaines'>;
}

interface Props {
  chapitre: CollectionEntry<'chapitres'>;
  cours: CollectionEntry<'cours'>;
  domaine: CollectionEntry<'domaines'>;
  headings: Heading[];
  precedent?: ChapitreVoisin | null;
  suivant?: ChapitreVoisin | null;
}

const { chapitre, cours, domaine, headings, precedent = null, suivant = null } = Astro.props;
const t = useTranslations();
const { titre, description, duree, niveau, objectifs, prerequis, quiz, maj } = chapitre.data;

const dateMaj = maj.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const cle = cleChapitre(cours.data.slug, chapitre.data.slug);
const urlPage = new URL(urlChapitre(chapitre, cours, domaine), Astro.site).toString();
const imageOg = `/og/${cours.data.slug}/${chapitre.data.slug}.png`;

const fils = [
  { label: t.nav.cours, href: '/fr/cours/' },
  { label: domaine.data.titre, href: urlDomaine(domaine) },
  { label: cours.data.titre, href: urlCours(cours, domaine) },
  { label: chapitre.data.titreCourt }
];
---

<BaseLayout titre={titre} description={description} image={imageOg} type="article">
  <Fragment slot="tete">
    <DonneesStructurees type="BreadcrumbList" fils={fils} />
    <DonneesStructurees
      type="TechArticle"
      titre={titre}
      description={description}
      url={urlPage}
      datePublication={maj}
      dateModification={maj}
    />
  </Fragment>

  <div class="mx-auto max-w-5xl px-4 py-8 lg:grid lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-10">
    <article class="max-w-[70ch]" data-pagefind-body data-cle-page={cle}>
      <div data-pagefind-ignore>
        <FilAriane fils={fils} />
      </div>

      <h1 class="mt-3 text-3xl font-bold">{titre}</h1>
      <p class="mt-2 text-sm" style="color: var(--couleur-texte-attenue);">
        {duree} {t.cours.minutes} · {t.niveau[niveau]} · {dateMaj}
      </p>

      <div class="mt-6 space-y-4">
        <EncadreObjectifs objectifs={objectifs} />
        <EncadrePrerequis prerequis={prerequis} />
      </div>

      <div data-pagefind-ignore>
        <SlotPub emplacement={1} />
      </div>

      <div class="contenu-chapitre prose mt-8 max-w-none">
        <slot />
      </div>

      {quiz.length > 0 && <Quiz questions={quiz} cle={cle} />}

      <div data-pagefind-ignore>
        <NavChapitre precedent={precedent} suivant={suivant} />
      </div>

      <!-- Emplacement n°3 placé après la navigation plutôt que juste après
           "à retenir" / le quiz : invariant n°5 (jamais à moins de 200 px
           d'un bloc interactif), et le quiz contient des champs cochables. -->
      <div data-pagefind-ignore>
        <SlotPub emplacement={3} />
      </div>

      <div data-pagefind-ignore>
        <PourAllerPlusLoin chapitre={chapitre} />
      </div>

      <Commentaires />
    </article>

    <div>
      <SommaireLateral headings={headings} />
      <SlotPub emplacement={4} />
    </div>
  </div>
</BaseLayout>

<script>
  import { marquerChapitreVu } from '../scripts/progression';

  const cle = document.querySelector<HTMLElement>('[data-cle-page]')?.dataset.clePage;
  if (cle) marquerChapitreVu(cle);
</script>
