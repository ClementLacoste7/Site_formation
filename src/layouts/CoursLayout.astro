---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FilAriane from '../components/nav/FilAriane.astro';
import BarreProgression from '../components/nav/BarreProgression.astro';
import CarteChapitre from '../components/contenu/CarteChapitre.astro';
import DonneesStructurees from '../components/seo/DonneesStructurees.astro';
import { useTranslations } from '../i18n/utils';
import { urlDomaine, urlCours, urlFiche } from '../lib/contenu';

interface Props {
  cours: CollectionEntry<'cours'>;
  domaine: CollectionEntry<'domaines'>;
  chapitres: CollectionEntry<'chapitres'>[];
}

const { cours, domaine, chapitres } = Astro.props;
const t = useTranslations();
const urlPage = new URL(urlCours(cours, domaine), Astro.site).toString();

// Maillage réciproque : la fiche de révision liée à ce cours, s'il y en a une.
const fichesLiees = (await getCollection('fiches')).filter((f) => f.data.coursLie.id === cours.id);

const fils = [
  { label: t.nav.cours, href: '/fr/cours/' },
  { label: domaine.data.titre, href: urlDomaine(domaine) },
  { label: cours.data.titre }
];
---

<BaseLayout titre={cours.data.titre} description={cours.data.description}>
  <Fragment slot="tete">
    <DonneesStructurees type="BreadcrumbList" fils={fils} />
    <DonneesStructurees
      type="Course"
      titre={cours.data.titre}
      description={cours.data.description}
      url={urlPage}
    />
  </Fragment>

  <div class="mx-auto max-w-5xl px-4 py-8" data-pagefind-body>
    <div data-pagefind-ignore>
      <FilAriane fils={fils} />
    </div>

    <h1 class="mt-3 text-3xl font-bold">{cours.data.titre}</h1>
    <p class="mt-2" style="color: var(--couleur-texte-attenue);">{cours.data.description}</p>
    <p class="mt-2 text-sm" style="color: var(--couleur-texte-attenue);">
      {t.niveau[cours.data.niveau]} · {cours.data.dureeTotale} {t.cours.minutes}
    </p>

    <BarreProgression cours={cours} chapitres={chapitres} />

    <h2 class="mt-8 font-semibold">{t.cours.chapitres}</h2>
    <p class="mt-1 text-xs" style="color: var(--couleur-texte-attenue);">{t.cours.ordreConseille}</p>
    <div class="mt-3 space-y-2">
      {chapitres.map((chapitre) => (
        <CarteChapitre chapitre={chapitre} cours={cours} domaine={domaine} />
      ))}
    </div>

    {fichesLiees.length > 0 && (
      <div class="mt-8 border-t pt-6" style="border-color: var(--couleur-bordure);" data-pagefind-ignore>
        {fichesLiees.map((fiche) => (
          <a
            href={urlFiche(fiche)}
            class="block rounded-lg border p-4 text-sm transition hover:border-[var(--couleur-accent)]"
            style="border-color: var(--couleur-bordure);"
          >
            {t.fiche.ficheAssociee} <strong>{fiche.data.titre}</strong>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
