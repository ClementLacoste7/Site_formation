---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import FilAriane from '../../../../components/nav/FilAriane.astro';
import CarteCours from '../../../../components/contenu/CarteCours.astro';
import { locales, useTranslations } from '../../../../i18n/utils';

export async function getStaticPaths() {
  const domaines = await getCollection('domaines');
  const paths = [];
  for (const domaine of domaines) {
    for (const lang of locales) {
      paths.push({ params: { lang, domaine: domaine.data.slug }, props: { domaine } });
    }
  }
  return paths;
}

const { domaine } = Astro.props;
const t = useTranslations();

const tousLesCours = await getCollection('cours');
const cours = tousLesCours
  .filter((c) => c.data.domaine.id === domaine.id && c.data.publie)
  .sort((a, b) => a.data.ordre - b.data.ordre);
---

<BaseLayout titre={domaine.data.titre} description={domaine.data.description}>
  <div class="mx-auto max-w-5xl px-4 py-8">
    <FilAriane fils={[{ label: t.nav.cours, href: '/fr/cours/' }, { label: domaine.data.titre }]} />

    <h1 class="mt-3 text-3xl font-bold">{domaine.data.titre}</h1>
    <p class="mt-2" style="color: var(--couleur-texte-attenue);">{domaine.data.description}</p>

    <h2 class="mt-8 font-semibold">{t.domaine.coursDisponibles}</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      {cours.map((c) => (
        <CarteCours cours={c} domaine={domaine} />
      ))}
    </div>
  </div>
</BaseLayout>
