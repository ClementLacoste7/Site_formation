---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FilAriane from '../../../components/nav/FilAriane.astro';
import DonneesStructurees from '../../../components/seo/DonneesStructurees.astro';
import { locales, useTranslations } from '../../../i18n/utils';
import { urlDomaine, urlCours } from '../../../lib/contenu';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const t = useTranslations();
const domaines = (await getCollection('domaines')).sort((a, b) => a.data.ordre - b.data.ordre);
const fils = [{ label: t.nav.cours }];

const coursPublies = (await getCollection('cours')).filter((c) => c.data.publie);
const chapitresPublies = (await getCollection('chapitres')).filter((c) => c.data.publie);

// Nombre de chapitres par cours, calculé une fois plutôt qu'à chaque domaine.
const nbChapitresParCours = new Map<string, number>();
for (const chapitre of chapitresPublies) {
  const id = chapitre.data.cours.id;
  nbChapitresParCours.set(id, (nbChapitresParCours.get(id) ?? 0) + 1);
}
---

<BaseLayout titre={t.catalogue.titre} description={t.catalogue.description}>
  <Fragment slot="tete">
    <DonneesStructurees type="BreadcrumbList" fils={fils} />
  </Fragment>

  <div class="mx-auto max-w-5xl px-4 py-8">
    <FilAriane fils={fils} />

    <h1 class="mt-3 text-3xl font-bold">{t.catalogue.titre}</h1>
    <p class="mt-2" style="color: var(--couleur-texte-attenue);">{t.catalogue.description}</p>

    <div class="mt-6 space-y-3">
      {domaines.map((domaine) => {
        const coursDuDomaine = coursPublies
          .filter((c) => c.data.domaine.id === domaine.id)
          .sort((a, b) => a.data.ordre - b.data.ordre);

        return (
          <details class="accordeon-domaine rounded-lg border" style="border-color: var(--couleur-bordure);">
            <summary
              class="accordeon-domaine__entete"
              aria-label={`${t.domaine.afficherCoursDe} ${domaine.data.titre}`}
            >
              <a href={urlDomaine(domaine)} class="accordeon-domaine__titre font-semibold">
                {domaine.data.titre}
              </a>
              <span class="accordeon-domaine__chevron" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 6 15 12 9 18"></polyline>
                </svg>
              </span>
            </summary>
            <div class="border-t px-4 pb-4 pt-3" style="border-color: var(--couleur-bordure);">
              <p class="text-sm" style="color: var(--couleur-texte-attenue);">{domaine.data.description}</p>
              <ul class="mt-3 space-y-2">
                {coursDuDomaine.map((cours) => {
                  const nbChapitres = nbChapitresParCours.get(cours.id) ?? 0;
                  const libelleChapitres = nbChapitres === 1 ? t.cours.chapitreSingulier : t.cours.chapitrePluriel;
                  return (
                    <li>
                      <a
                        href={urlCours(cours, domaine)}
                        class="block rounded-md border p-3 transition hover:border-[var(--couleur-accent)]"
                        style="border-color: var(--couleur-bordure);"
                      >
                        <p class="font-medium">{cours.data.titre}</p>
                        <p class="mt-1 text-xs" style="color: var(--couleur-texte-attenue);">
                          {t.niveau[cours.data.niveau]} · {nbChapitres} {libelleChapitres}
                        </p>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </details>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  /* Accordéon natif <details>/<summary> : pas de JS, accessible clavier par
     défaut. Le titre du domaine reste un vrai lien (voir CLAUDE.md), seule
     l'icône chevron partage la zone de déclenchement du <summary>. */
  .accordeon-domaine__entete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem;
    cursor: pointer;
    list-style: none;
  }
  .accordeon-domaine__entete::-webkit-details-marker {
    display: none;
  }
  .accordeon-domaine__entete::marker {
    content: '';
  }

  .accordeon-domaine__titre {
    color: var(--couleur-texte);
  }
  .accordeon-domaine__titre:hover {
    color: var(--couleur-accent);
  }

  .accordeon-domaine__chevron {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--couleur-texte-attenue);
    transition: transform 0.2s ease;
  }
  .accordeon-domaine[open] > .accordeon-domaine__entete .accordeon-domaine__chevron {
    transform: rotate(90deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .accordeon-domaine__chevron {
      transition: none;
    }
  }
</style>
