---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FilAriane from '../../../components/nav/FilAriane.astro';
import { locales, useTranslations } from '../../../i18n/utils';
import { urlDomaine } from '../../../lib/contenu';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const t = useTranslations();
const domaines = (await getCollection('domaines')).sort((a, b) => a.data.ordre - b.data.ordre);
---

<BaseLayout titre={t.catalogue.titre} description={t.catalogue.description}>
  <div class="mx-auto max-w-5xl px-4 py-8">
    <FilAriane fils={[{ label: t.nav.cours }]} />

    <h1 class="mt-3 text-3xl font-bold">{t.catalogue.titre}</h1>
    <p class="mt-2" style="color: var(--couleur-texte-attenue);">{t.catalogue.description}</p>

    <div class="mt-6 space-y-3">
      {domaines.map((domaine) => (
        <a
          href={urlDomaine(domaine)}
          class="block rounded-lg border p-4 transition hover:border-[var(--couleur-accent)]"
          style="border-color: var(--couleur-bordure);"
        >
          <h2 class="font-semibold">{domaine.data.titre}</h2>
          <p class="mt-1 text-sm" style="color: var(--couleur-texte-attenue);">
            {domaine.data.description}
          </p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
