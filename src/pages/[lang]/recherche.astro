---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilAriane from '../../components/nav/FilAriane.astro';
import RechercheUI from '../../components/nav/RechercheUI.astro';
import { locales, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const t = useTranslations();
---

<BaseLayout titre={t.recherche.titre}>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <FilAriane fils={[{ label: t.recherche.titre }]} />
    <h1 class="mt-3 text-3xl font-bold">{t.recherche.titre}</h1>
    <div class="mt-6">
      <RechercheUI id="page" />
    </div>
  </div>
</BaseLayout>
